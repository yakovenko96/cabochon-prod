<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_integrity_report_list" model="ir.ui.view">
        <field name="name">cabochon.integrity.report.list</field>
        <field name="model">cabochon.integrity.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="problem"/>
                <field name="lot_id"/>
                <field name="request_id"/>
                <field name="transfer_id"/>
                <field name="movement_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_source" type="object" string="Открыть"/>
            </list>
        </field>
    </record>
    <record id="action_integrity_report" model="ir.actions.act_window">
        <field name="name">Контроль целостности</field>
        <field name="res_model">cabochon.integrity.report</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p>Список требует проверки администратором. История и остатки автоматически не исправляются. Пустой список не заменяет инвентаризацию.</p></field>
    </record>
    <record id="view_scan_lot_form" model="ir.ui.view">
        <field name="name">cabochon.scan.lot.form</field>
        <field name="model">cabochon.scan.lot</field>
        <field name="arch" type="xml">
            <form string="Найти мешок">
                <group><field name="code" placeholder="Отсканируйте или введите код"/></group>
                <footer><button name="action_open" type="object" string="Открыть мешок" class="btn-primary"/><button special="cancel" string="Отмена"/></footer>
            </form>
        </field>
    </record>
    <record id="action_scan_lot" model="ir.actions.act_window">
        <field name="name">Найти мешок по коду</field>
        <field name="res_model">cabochon.scan.lot</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
